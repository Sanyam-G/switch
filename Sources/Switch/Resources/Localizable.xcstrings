    "Two permissions before you can switch windows.": {
      "comment": "Onboarding subtitle when thumbnails need Screen Recording",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two permissions before you can switch windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换窗口前需要两项权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換視窗前需要兩項權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを切り替える前に、2つのアクセス権が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 전환하려면 권한 두 가지가 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Freigaben, bevor du Fenster wechseln kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux autorisations avant de pouvoir changer de fenêtre."
          }
        },
        "es": {
