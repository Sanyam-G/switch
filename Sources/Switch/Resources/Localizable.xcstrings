            "value": "How much the desktop blurs through the picker background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面透过选择器背景的模糊程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面透過選擇器背景的模糊程度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピッカーの背景からデスクトップがどれだけぼけるか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피커 배경으로 데스크톱이 얼마나 흐려지는지."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark der Schreibtisch durch den Umschalter-Hintergrund unscharf wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Degré de flou du bureau à travers le fond du sélecteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se difumina el escritorio tras el fondo del selector."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a mesa se desfoca através do fundo do seletor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько рабочий стол размыт за фоном панели."
          }
        }
      }
    },
