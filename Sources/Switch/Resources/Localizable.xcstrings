        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘를 놓아도 피커가 열린 채로 남습니다. Return으로 전환, Esc로 취소."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ loslassen lässt den Umschalter offen. Return wechselt, Esc bricht ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâcher ⌘ laisse le sélecteur ouvert. Retour pour basculer, Esc pour annuler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar ⌘ deja el selector abierto. Retorno para cambiar, Esc para cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar ⌘ deixa o seletor aberto. Return para trocar, Esc para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите ⌘ — панель останется открытой. Return переключает, Esc отменяет."
