    "While holding the hotkey, tap Shift to step backward. ⇧-Tab still works too.": {
      "comment": "Settings row detail",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While holding the hotkey, tap Shift to step backward. ⇧-Tab still works too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快捷键时点按 Shift 可反向步进。⇧-Tab 仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快速鍵時點按 Shift 可反向步进。⇧-Tab 仍然可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーを押したまま Shift をタップすると逆方向に進みます。⇧-Tab も使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누른 채 Shift를 탭하면 반대로 이동합니다. ⇧-Tab도 동작합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei gedrücktem Kürzel Shift tippen, um zurückzugehen. ⇧-Tab funktioniert weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En maintenant le raccourci, un appui sur Maj recule. ⇧-Tab fonctionne aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el atajo pulsado, toca Mayús para ir atrás. ⇧-Tab sigue funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o atalho pressionado, toque Shift para voltar. ⇧-Tab também funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживая сочетание, нажмите Shift, чтобы шагнуть назад. ⇧-Tab тоже работает."
          }
        }
      }
    },
