    "Intercept ⌘-Tab and ⌥-` system-wide.": {
      "comment": "Settings Accessibility detail",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercept ⌘-Tab and ⌥-` system-wide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在全系统拦截 ⌘-Tab 和 ⌥-`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在全系統攔截 ⌘-Tab 與 ⌥-`。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体で ⌘-Tab と ⌥-` を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 전역에서 ⌘-Tab과 ⌥-`를 가로챕니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fängt ⌘-Tab und ⌥-` systemweit ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepte ⌘-Tab et ⌥-` à l’échelle du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepta ⌘-Tab y ⌥-` en todo el sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepta ⌘-Tab e ⌥-` no sistema todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехватывает ⌘-Tab и ⌥-` по всей системе."
          }
        }
      }
    },
