    "Look for new versions in the background and offer to install them. Turn off if you update through Homebrew.": {
      "comment": "Settings row detail",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for new versions in the background and offer to install them. Turn off if you update through Homebrew."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台查找新版本并提示安装。若通过 Homebrew 更新，请关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在背景尋找新版本並提示安裝。若透過 Homebrew 更新，請關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで新バージョンを確認し、インストールを提案します。Homebrew で更新する場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 새 버전을 찾아 설치를 제안합니다. Homebrew로 업데이트한다면 끄세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht im Hintergrund nach neuen Versionen und bietet die Installation an. Ausschalten, wenn du über Homebrew aktualisierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche les nouvelles versions en arrière-plan et propose l’installation. Désactivez si vous mettez à jour via Homebrew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca versiones nuevas en segundo plano y ofrece instalarlas. Desactívalo si actualizas con Homebrew."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura novas versões em segundo plano e oferece a instalação. Desative se atualizar pelo Homebrew."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
