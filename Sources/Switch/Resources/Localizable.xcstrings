    "Needs at least one modifier (⌘, ⌥, or ⌃).": {
      "comment": "Hotkey rejected: no modifier",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs at least one modifier (⌘, ⌥, or ⌃)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一个修饰键（⌘、⌥ 或 ⌃）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一個修飾鍵（⌘、⌥ 或 ⌃）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キー（⌘、⌥、⌃）が少なくとも1つ必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 키(⌘, ⌥ 또는 ⌃)가 하나 이상 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens ein Modifikator (⌘, ⌥ oder ⌃) nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins un modificateur (⌘, ⌥ ou ⌃)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta al menos un modificador (⌘, ⌥ o ⌃)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ao menos um modificador (⌘, ⌥ ou ⌃)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен хотя бы один модификатор (⌘, ⌥ или ⌃)."
          }
        }
      }
    },
    "That combo is reserved by macOS or common apps.": {
      "comment": "Hotkey rejected: reserved combo",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That combo is reserved by macOS or common apps."
          }
        },
        "zh-Hans": {
