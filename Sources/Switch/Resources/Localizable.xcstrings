    "Switch needs Accessibility for the ⌘-Tab hotkey. Screen Recording is only needed when thumbnails are enabled.": {
      "comment": "Permissions intro",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch needs Accessibility for the ⌘-Tab hotkey. Screen Recording is only needed when thumbnails are enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 需要辅助功能权限才能使用 ⌘-Tab。仅在启用缩略图时才需要屏幕录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 需要輔助使用權限才能使用 ⌘-Tab。僅在啟用縮圖時才需要螢幕錄製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-Tab にはアクセシビリティが必要です。サムネイルを使うときだけ画面収録が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-Tab 단축키에는 손쉬운 사용이 필요합니다. 축소판을 켤 때만 화면 기록이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch braucht Bedienungshilfen für ⌘-Tab. Bildschirmaufnahme nur bei Miniaturen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch a besoin d’Accessibilité pour ⌘-Tab. L’enregistrement d’écran n’est requis que pour les miniatures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch necesita Accesibilidad para ⌘-Tab. Grabación de pantalla solo si hay miniaturas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Switch precisa de Acessibilidade para ⌘-Tab. Gravação de Tela só com miniaturas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ⌘-Tab нужен Универсальный доступ. Запись экрана — только если включены миниатюры."
          }
        }
      }
    },
