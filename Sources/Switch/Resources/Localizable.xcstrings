          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇器開啟時可透過輸入過濾視窗。關閉後 ⌘W/⌘Q/⌘H 可直接使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピッカー表示中に入力してウインドウを絞り込みます。オフにすると ⌘W/⌘Q/⌘H がそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피커가 열린 동안 입력으로 윈도우를 거릅니다. 끄면 ⌘W/⌘Q/⌘H가 바로 동작합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster bei offenem Umschalter per Tastatur filtern. Aus: ⌘W/⌘Q/⌘H wirken direkt."
          }
        },
        "fr": {
          "stringUnit": {
