    "Follows System Settings. Restart Switch after changing.": {
      "comment": "Language row detail",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows System Settings. Restart Switch after changing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统设置。更改后请重新启动 Switch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統設定。變更後請重新啟動 Switch。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定に従います。変更後は Switch を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정을 따릅니다. 변경 후 Switch를 다시 시작하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt den Systemeinstellungen. Switch danach neu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit les Réglages Système. Relancez Switch après modification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue Ajustes del Sistema. Reinicia Switch después de cambiarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue Ajustes do Sistema. Reinicie o Switch depois de alterar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в Системных настройках. После смены перезапустите Switch."
          }
        }
      }
    },
